# Server
PORT=5000

# PostgreSQL (use Render's managed Postgres, or any SQL provider)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# AI API key (Anthropic Claude example - get one at console.anthropic.com)
ANTHROPIC_API_KEY=your_api_key_here

# Allowed frontend origin (your Vercel URL) for CORS
FRONTEND_ORIGIN=https://your-app.vercel.app
